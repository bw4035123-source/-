# 이 파일을 .env.local 로 복사한 뒤 값을 채우세요 (.env.local 은 git에 올라가지 않습니다)
# 국가법령정보센터 Open API 인증키(OC) — open.law.go.kr 에서 신청, 이 PC의 공인 IP 등록 필요
LAW_API_OC=

# CORS 허용 출처(쉼표 구분). * 는 모두 허용
CORS_ORIGINS=*

# 공개 URL로 열 때 권장: 설정하면 X-Proxy-Token 헤더(또는 ?token=)가 일치해야 /api/* 호출 가능
PROXY_TOKEN=

# IP당 분당 호출 수 / 캐시(초) / 법령센터 응답 대기(초)
RATE_LIMIT_PER_MIN=300
CACHE_TTL_SEC=21600
UPSTREAM_TIMEOUT_SEC=15
