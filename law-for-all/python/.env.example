# ─────────────────────────────────────────────────────────────
# 법이음(LAW:ON) 환경설정 — 이 파일을 .env.local 로 복사해 사용
# 아무 값도 넣지 않아도 '내장 법령 데이터 + 규칙기반 엔진'으로 완전 시연됩니다.
# ─────────────────────────────────────────────────────────────

# [1] 법제처 국가법령정보 Open API 인증키(OC) — https://open.law.go.kr 에서 신청, 실행하는 PC·서버의 공인 IP 등록
#     넣으면 법령·행정규칙·자치법규·판례 전체를 실시간으로 조회합니다. 비워 두면 내장 핵심 법령 23종으로 동작합니다.
LAW_API_OC=

# [1-1] 법령 API 중계 서버 — 비워 두면 법이음 클라우드 서버(lawon.onrender.com) 경유: 이 PC에 인증키·IP 등록이 없어도 판례·실시간 법령.
#       off 로 쓰면 위 인증키로 www.law.go.kr 을 직접 호출(이 PC의 공인 IP가 open.law.go.kr 에 등록돼 있어야 함).
LAW_PROXY_URL=
LAW_PROXY_TOKEN=

# [2] 기본 LLM 공급자: mock | openai | anthropic | ollama
#     화면 상단 'AI 모델' 메뉴에서 설정된 공급자끼리 실시간 전환도 가능합니다.
LLM_PROVIDER=mock

# OpenAI 및 OpenAI 호환 API(Upstage Solar, vLLM, LM Studio 등)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Ollama(온프레미스·폐쇄망 로컬 LLM: exaone3.5, gemma3, llama3.1, solar 등)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=exaone3.5:7.8b

# LLM 호출 제한시간(ms)
LLM_TIMEOUT_MS=45000
