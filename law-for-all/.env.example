# ─────────────────────────────────────────────────────────────
# 모두의 법(Law For All) 환경설정 — 이 파일을 .env.local 로 복사해 사용
# 아무 값도 넣지 않아도 '내장 법령 데이터 + 규칙기반 엔진'으로 완전 시연됩니다.
# ─────────────────────────────────────────────────────────────

# [1] 국가법령정보 공동활용 Open API 인증키(OC) — https://open.law.go.kr 에서 신청
#     비워 두면 내장 모의데이터(11개 핵심 법령)로 동작합니다.
LAW_API_OC=

# [2] 기본 LLM 공급자: mock | openai | anthropic | ollama
#     화면 상단 'AI 모델' 메뉴에서 설정된 공급자끼리 실시간 전환도 가능합니다.
LLM_PROVIDER=mock

# OpenAI 및 OpenAI 호환 API(Upstage Solar, vLLM, LM Studio 등)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Ollama(온프레미스·폐쇄망 로컬 LLM: exaone3.5, gemma3, llama3.1, solar 등)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=exaone3.5:7.8b

# LLM 호출 제한시간(ms)
LLM_TIMEOUT_MS=45000
